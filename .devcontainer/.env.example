# Copy this file to .env (in the same folder) and fill in the two values
# below, live during the webinar, after generating a Dynatrace API token.
# See: Foundation > Dynatrace Setup, or the walkthrough in class.
#
# .env is gitignored on purpose. Never commit your real token.
#
# After editing .env, apply the change with:
#   docker restart dt-otel-collector
DT_TENANT=
DT_API_TOKEN=
