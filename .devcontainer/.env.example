# Copy this file to .env (in the same folder) and fill in the values below,
# live during the webinar, after generating a Dynatrace API token.
# See: Foundation > Dynatrace Setup, or the walkthrough in class.
#
# .env is gitignored on purpose. Never commit your real token.
#
# After editing .env, apply the change with:
#   docker compose -f .devcontainer/docker-compose.yml up -d otel-collector

# ── OTel Collector ────────────────────────────────────────────────────────────
# Just the tenant ID — substituted into collector.config.yaml.
# Example: abc12345
DT_TENANT=

# Classic API token (dt0c01.) with openTelemetryTrace.ingest + metrics.ingest.
DT_API_TOKEN=

# ── dtctl (DQL queries from the terminal) ─────────────────────────────────────
# Platform token (dt0s16.) with storage:logs:read + storage:metrics:read.
# This is a separate token from DT_API_TOKEN — generate it under
# Account Management → Platform tokens.
# The environment URL is derived from DT_TENANT: https://<DT_TENANT>.apps.dynatrace.com
DTCTL_PLATFORM_TOKEN=

# AWS Guardrail ID
GUARDRAIL_ID=
